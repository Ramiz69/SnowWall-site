// Cloudflare Workers Builds deploys this on every push to main (see README, "Cloudflare deployment").
{
  "name": "snowwall-site",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only video goes through the Worker; every other path is served straight from public/.
    "run_worker_first": ["/assets/*.mp4", "/press/*.mp4"]
  }
}
